<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <RootNamespace>Axl.Base.Sftp</RootNamespace>
    <AssemblyName>Axl.Base.Sftp</AssemblyName>
    
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Axl.Base.Sftp</PackageId>
    <Version>1.1.2</Version>
    <Authors>Axl</Authors>
    <Description>Library for SFTP operations based on SSH.NET.</Description>
    <PackageOutputPath>c:\Users\Axl\Desktop\Projects\LocalNugetFeed</PackageOutputPath>

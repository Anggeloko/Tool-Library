<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net40;net45</TargetFrameworks>
    <RootNamespace>Axl.Base.Orchestrator.Scheduler</RootNamespace>
    <AssemblyName>Axl.Base.Orchestrator.Scheduler</AssemblyName>
    
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Axl.Base.Orchestrator.Scheduler</PackageId>
    <Version>1.0.1</Version>
    <Authors>Axl</Authors>
    <Description>Orchestration library for dynamically scheduled background tasks following Hexagonal Architecture and Strategy pattern.</Description>
    <PackageOutputPath>c:\Users\Axl\Desktop\Projects\LocalNugetFeed</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Axl.Base.Common\Axl.Base.Common.csproj" />
    <ProjectReference Include="..\Axl.Base.Background\Axl.Base.Background.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.Bcl.Async" Version="1.0.168" />
  </ItemGroup>
</Project>
